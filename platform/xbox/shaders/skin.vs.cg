/* skin.vs.cg - the NV2A vertex program that poses a skinned mesh (nxdk-gles11 gliSkinDraw,
 * platform/xbox/patches/nxdk-gles11-direct-draw.patch). Compiled to skin.vs.inl:
 *     cgc -profile vp20 -o skin.vsh skin.vs.cg && vp20compiler skin.vsh > skin.vs.inl
 *
 * What the fixed-function pipeline did for the vertices the CPU had posed, with the posing in front:
 * up to four bones' matrices blended by the vertex's weights, the result through the composite
 * matrix to the screen, the normal to eye space and lit by the scene's ambient and up to three
 * directional lights (GL_COLOR_MATERIAL: the vertex colour is the material), the eye depth as the
 * fog coordinate, the texture coordinates scaled to what the bound texture wants.
 *
 * Constants (c[0] is NV2A constant 96; only the 96 user constants are used, the fixed-function
 * state below them is untouched):
 *   c[0..3]    screen: viewport x projection x modelview, its rows
 *   c[4..81]   26 bones, three rows each
 *   c[82..84]  eye: the modelview's upper 3 rows
 *   c[85]      ambient (the light model's), rgb; a: 1 when lit, 0: the colour as it is
 *   c[86..88]  the directional lights' directions in eye space (towards the light), w 0
 *   c[89..91]  their diffuse colours
 *   c[92]      x, y: texture coordinate scale
 *   c[93]      0 1 3 (the compiler's literals)
 */
struct vIn {
    float4 pos    : POSITION;
    float4 weight : TEXCOORD2;
    float3 norm   : NORMAL;
    float4 col    : COLOR0;
    float4 tex    : TEXCOORD0;
    float4 bone   : TEXCOORD1;
};

struct vOut {
    float4 pos  : POSITION;
    float4 col  : COLOR0;
    float  fog  : FOG;
    float4 tex0 : TEXCOORD0;
};

vOut main(vIn I,
          uniform float4x4 screen,
          uniform float4   eye[3],
          uniform float4   ambient,
          uniform float4   ldir[3],
          uniform float4   lcol[3],
          uniform float4   tscale,
          uniform float3x4 bones[26])
{
    vOut O;
    float4 p = float4(I.pos.xyz, 1.0);
    float3 n = I.norm;

    float3x4 b0 = bones[I.bone.x];
    float3 sp = I.weight.x * mul(b0, p);
    float3 sn = I.weight.x * mul((float3x3)b0, n);
    float3x4 b1 = bones[I.bone.y];
    sp += I.weight.y * mul(b1, p);
    sn += I.weight.y * mul((float3x3)b1, n);
    float3x4 b2 = bones[I.bone.z];
    sp += I.weight.z * mul(b2, p);
    sn += I.weight.z * mul((float3x3)b2, n);
    float3x4 b3 = bones[I.bone.w];
    sp += I.weight.w * mul(b3, p);
    sn += I.weight.w * mul((float3x3)b3, n);

    float4 mp = float4(sp, 1.0);
    float4 clip = mul(screen, mp);
    O.pos.xyz = clip.xyz / clip.w;
    O.pos.w = clip.w;

    float3 ne = normalize(float3(dot(eye[0].xyz, sn), dot(eye[1].xyz, sn), dot(eye[2].xyz, sn)));
    float3 light = ambient.rgb;
    light += max(dot(ne, ldir[0].xyz), 0.0) * lcol[0].rgb;
    light += max(dot(ne, ldir[1].xyz), 0.0) * lcol[1].rgb;
    light += max(dot(ne, ldir[2].xyz), 0.0) * lcol[2].rgb;
    float3 lit = saturate(I.col.rgb * light);
    O.col.rgb = lerp(I.col.rgb, lit, ambient.a);
    O.col.a = I.col.a;

    O.fog = clip.w;
    O.tex0 = float4(I.tex.x * tscale.x, I.tex.y * tscale.y, 0.0, 1.0);
    return O;
}
