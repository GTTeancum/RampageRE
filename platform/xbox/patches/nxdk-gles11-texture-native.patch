+/* The bound texture's storage replaced by an image that is already in one of the GPU's own formats, with its
+ * mip levels: no expansion to full colour on the way. The texture must be the one glTexImage2D has just made
+ * (level 0, full colour, a power of two each way: the frontend's size and the storage's).
+ *   kind 1: DXT1. data: each level's 4 x 4 blocks in rows (8 bytes a block; a level under 4 texels a side is
+ *           one block), the levels one after the other. Stored as it is.
+ *   kind 2: A1R5G5B5, kind 3: A4R4G4B4. data: each level's texels in rows, 16 bits little endian, the levels
+ *           one after the other. Each level is swizzled here.
+ * levels: 1 or more (each half the one before, down to 1 texel a side at the least); size: the bytes of data,
+ * which must be exactly what the levels come to. With more than one level the texture is sampled from the
+ * level that fits (GL_LINEAR_MIPMAP_NEAREST). GL_FALSE and nothing changed when the texture is not as expected
+ * or there is no memory. A DXT1 texture is not written to again (glTexSubImage2D and the mipmap generator
+ * refuse it: gliTextureUnpackPalette). */
+GLboolean gliTextureNative(GLsizei width, GLsizei height, GLint kind, const GLubyte *data, GLsizei size, GLsizei levels)
+{
+    gli_context_t *context = gliGetContext();
+    GLuint unit = context->texture_environment.server_active_texture - GL_TEXTURE0;
+    texture_object_t *object = context->texture_environment.texture_units[unit].bound_texture_object;
+    xgu_texture_t *texture = object ? (xgu_texture_t *)object->texture_2d : NULL;
+    if (!data || !texture || !texture->data || texture->palette_offset || !texture->swizzled ||
+        texture->mipmap_levels != 1 || object->generate_mipmap ||
+        texture->format != XGU_TEXTURE_FORMAT_A8R8G8B8_SWIZZLED || texture->bytes_per_pixel != 4 ||
+        width < 4 || height < 4 || texture->tex_width != width || texture->tex_height != height ||
+        texture->data_width != width || texture->data_height != height || width > 4096 || height > 4096 ||
+        kind < 1 || kind > 3 || levels < 1 || levels > 13 || size <= 0)
+        return GL_FALSE;
+    size_t expected = 0;
+    {
+        GLuint w = (GLuint)width, h = (GLuint)height;
+        for (GLsizei l = 0; l < levels; l++) {
+            if (l && w == 1 && h == 1) return GL_FALSE;          /* (more levels than the size has) */
+            if (l) { w = w > 1 ? w / 2 : 1; h = h > 1 ? h / 2 : 1; }
+            expected += kind == 1 ? (size_t)(w >= 4 ? w / 4 : 1) * (h >= 4 ? h / 4 : 1) * 8u : (size_t)w * h * 2u;
+        }
+    }
+    if (expected != (size_t)size) return GL_FALSE;
+    size_t bytes = (expected + 63u) & ~(size_t)63u;
+    GLubyte *store = MmAllocateContiguousMemoryEx(bytes, 0, 0x03FFAFFF, 0x1000, PAGE_READWRITE | PAGE_WRITECOMBINE);
+    if (!store) return GL_FALSE;
+    if (kind == 1)
+        gli_memcpy(store, data, expected);
+    else {
+        GLuint w = (GLuint)width, h = (GLuint)height;
+        size_t at = 0;
+        for (GLsizei l = 0; l < levels; l++) {
+            if (l) { w = w > 1 ? w / 2 : 1; h = h > 1 ? h / 2 : 1; }
+            swizzle_rect(data + at, w, h, store + at, w * 2u, 2);
+            at += (size_t)w * h * 2u;
+        }
+    }
+    __asm__ volatile("sfence" ::: "memory");
+    MmFreeContiguousMemory(texture->data);
+    texture->data = store;
+    texture->data_physical_address = (GLubyte *)MmGetPhysicalAddress(store);
+    texture->data_size = bytes;
+    texture->bytes_per_pixel = kind == 1 ? 1 : 2;            /* (DXT1: half a byte; nothing reads it for one) */
+    texture->pitch = texture->data_width * texture->bytes_per_pixel;
+    texture->format = (XguTexFormatColor)(kind == 1 ? NV097_SET_TEXTURE_FORMAT_COLOR_L_DXT1_A1R5G5B5 :
+                                          kind == 2 ? NV097_SET_TEXTURE_FORMAT_COLOR_SZ_A1R5G5B5 :
+                                                      NV097_SET_TEXTURE_FORMAT_COLOR_SZ_A4R4G4B4);
+    texture->mipmap_levels = (uint8_t)levels;
+    if (levels > 1)
+        object->min_filter = GL_LINEAR_MIPMAP_NEAREST;        /* (the frontend above still believes GL_LINEAR) */
+    object->texture_object_dirty = GL_TRUE;
+    return GL_TRUE;
+}
