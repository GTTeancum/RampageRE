diff --git a/gles_xbox_direct.c b/gles_xbox_direct.c
new file mode 100644
index 0000000..a3114a6
--- /dev/null
+++ b/gles_xbox_direct.c
@@ -0,0 +1,342 @@
+/* gles_xbox_direct.c - draws that go straight to the NV2A.
+ *
+ * glDrawElements reaches the GPU through gl4es (its vertex attribute bookkeeping, its texture
+ * coordinate fix-ups) and the client arrays of this library (staging, the static-array lookups, a
+ * MmGetPhysicalAddress for every attribute): some tens of microseconds for every draw whatever
+ * its size, and a city frame is several hundred draws. An application whose arrays are already
+ * in GPU memory (gliStaticArrayAlloc, gliStaticArrayAddress) draws them from here instead: the
+ * GL state is flushed as for any draw, the arrays are named to the NV2A by their addresses, the
+ * indices follow. The client-array state of the library is not touched, only marked to be sent
+ * again by the next ordinary draw; gl4es is not involved (the application asks it first whether
+ * it has pending texture work: gl4es_xbox_predraw).
+ *
+ * gliSkinDraw does the same for a skinned mesh, with a vertex program that poses it (shaders/
+ * skin.vs.cg in the tree of the application): the matrices of the bones are sent as constants and
+ * the GPU blends them, where the application posed every vertex on the CPU and sent the result. */
+#include "gles_private.h"
+
+static inline uint32_t *direct_attrib(uint32_t *p, unsigned int index, unsigned int size, unsigned int stride,
+                                      const void *gpu)
+{
+    p = xgu_set_vertex_data_array_format(p, index, XGU_FLOAT, size, stride);
+    /* contiguous memory maps at 0x80000000 | physical: no kernel call to find it */
+    p = xgu_set_vertex_data_array_offset(p, index, (const void *)((uintptr_t)gpu & 0x03FFFFFFu));
+    return p;
+}
+
+static inline uint32_t *direct_attrib_off(uint32_t *p, unsigned int index)
+{
+    p = xgu_set_vertex_data_array_format(p, index, XGU_FLOAT, 0, 0);
+    p = xgu_set_vertex_data_array_offset(p, index, NULL);
+    return p;
+}
+
+/* the GL state but for the client arrays (gliFlushStateChange without gliArrayFlush) */
+static void direct_flush_state(void)
+{
+    gliFBOFlush();
+    gliTransformFlush();
+    gliTextureFlush();
+    gliPointParamsFlush();
+    gliLightingFlush();
+    gliFogFlush();
+}
+
+/* the next ordinary draw sends its client arrays again: the NV2A no longer has them */
+static void direct_arrays_dirty(vertex_array_data_t *vad)
+{
+    vad->vertex_array_dirty = GL_TRUE;
+    vad->color_array_dirty = GL_TRUE;
+    vad->normal_array_dirty = GL_TRUE;
+    vad->point_size_array_dirty = GL_TRUE;
+    vad->fog_coord_array_dirty = GL_TRUE;
+    for (GLuint i = 0; i < GLI_MAX_TEXTURE_UNITS; i++)
+        vad->texcoord_array_dirty[i] = GL_TRUE;
+}
+
+/* the arrays every direct draw has or has not: positions, normals (else the current normal), colours
+ * (else the current colour), texture coordinates of unit 0; the other arrays off */
+static uint32_t *direct_common_arrays(uint32_t *pb, gli_context_t *c, const float *pos, const float *nrm,
+                                      const float *uv, const float *col)
+{
+    vertex_array_data_t *vad = &c->vertex_array_data;
+    current_values_t *cv = &c->current_values;
+    pb = direct_attrib(pb, XGU_VERTEX_ARRAY, 3, 3 * sizeof(float), pos);
+    if (nrm)
+        pb = direct_attrib(pb, XGU_NORMAL_ARRAY, 3, 3 * sizeof(float), nrm);
+    else {
+        pb = direct_attrib_off(pb, XGU_NORMAL_ARRAY);
+        pb = xgu_set_vertex_data4f(pb, XGU_NORMAL_ARRAY, cv->current_normal[0], cv->current_normal[1],
+                                   cv->current_normal[2], 0.0f);
+    }
+    if (col)
+        pb = direct_attrib(pb, XGU_COLOR_ARRAY, 4, 4 * sizeof(float), col);
+    else {
+        pb = direct_attrib_off(pb, XGU_COLOR_ARRAY);
+        pb = xgu_set_vertex_data4f(pb, XGU_COLOR_ARRAY, cv->current_color[0], cv->current_color[1],
+                                   cv->current_color[2], cv->current_color[3]);
+    }
+    if (uv)
+        pb = direct_attrib(pb, XGU_TEXCOORD0_ARRAY, 2, 2 * sizeof(float), uv);
+    else
+        pb = direct_attrib_off(pb, XGU_TEXCOORD0_ARRAY);
+    for (GLuint i = 1; i < GLI_MAX_TEXTURE_UNITS && i < 4; i++)
+        if (vad->texcoord_array_enabled[i])
+            pb = direct_attrib_off(pb, XGU_TEXCOORD0_ARRAY + i);
+    if (vad->point_size_array_enabled)
+        pb = direct_attrib_off(pb, XGU_POINT_SIZE_ARRAY);
+    if (vad->fog_coord_array_enabled)
+        pb = direct_attrib_off(pb, XGU_FOG_ARRAY);
+    return pb;
+}
+
+/* Triangles from arrays that are in GPU memory (addresses as gliStaticArrayAlloc or gliStaticArrayAddress gave
+ * them, or inside such an array): 3 floats a position, 3 a normal, 2 a texture coordinate, 4 a colour; nrm, uv
+ * and col may be NULL. The GL state is what it is, as for glDrawElements. */
+void gliDirectDraw(const float *pos, const float *nrm, const float *uv, const float *col, const uint16_t *idx,
+                   GLsizei count)
+{
+    gli_context_t *c = gliGetContext();
+    if (count <= 0 || !pos || !idx)
+        return;
+    gliPushbufferReserve((size_t)count * 2u + 4096u);
+    direct_flush_state();
+    uint32_t *pb = pb_begin();
+    pb = direct_common_arrays(pb, c, pos, nrm, uv, col);
+    pb = pb_push1(pb, NV097_BREAK_VERTEX_BUFFER_CACHE, 0);
+    pb_end(pb);
+    xgux_draw_elements16(XGU_TRIANGLES, idx, (unsigned int)count);
+    direct_arrays_dirty(&c->vertex_array_data);
+}
+
