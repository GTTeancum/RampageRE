+static GLboolean skin_program_loaded;
+
+static uint32_t *skin_constants(uint32_t *pb, unsigned int at, const XguVec4 *v, unsigned int count)
+{
+    pb = xgu_set_transform_constant_load(pb, SKIN_CONSTANT_BASE + at);
+    while (count) {
+        unsigned int n = count < 8 ? count : 8;
+        pb = xgu_set_transform_constant(pb, v, n);
+        v += n;
+        count -= n;
+    }
+    return pb;
+}
+
+int gliSkinMaxBones(void)
+{
+    return SKIN_MAX_BONES;
+}
+
+/* A skinned mesh from arrays in GPU memory: pos, nrm, uv, col as for gliDirectDraw (nrm is needed); bone: 4
+ * floats a vertex, the indices of its bones in `palette`; weight: 4 floats, their weights (0: none). palette:
+ * nbones (at most gliSkinMaxBones) matrices, each its 3 rows of 4 (model space: where the bone takes a vertex
+ * of the bind pose). The modelview and projection, the lights (ambient and the first three directional ones,
+ * with the vertex colour of GL_COLOR_MATERIAL as the material), the fog and the bound texture are those of
+ * the GL. */
+void gliSkinDraw(const float *pos, const float *nrm, const float *uv, const float *col, const float *bone,
+                 const float *weight, const uint16_t *idx, GLsizei count, const float (*palette)[12], int nbones)
+{
+    gli_context_t *c = gliGetContext();
+    transformation_state_t *ts = &c->transformation_state;
+    lighting_state_t *ls = &c->lighting_state;
+    if (count <= 0 || !pos || !nrm || !bone || !weight || !idx || nbones <= 0 || nbones > SKIN_MAX_BONES)
+        return;
+    gliPushbufferReserve((size_t)count * 2u + 8192u);
+    direct_flush_state();           /* (the transform flush has made ts->vp_matrix current) */
+
+    static XguVec4 k[SKIN_C_COUNT];
+    mat4 *mv = &ts->modelview_matrix_stack[ts->modelview_matrix_stack_depth - 1];
+    mat4 screen;
+    glm_mat4_mul(ts->vp_matrix, *mv, screen);
+    for (int r = 0; r < 4; r++)     /* cglm is column-major: row r is [column][r] */
+        for (int q = 0; q < 4; q++)
+            k[SKIN_C_SCREEN + r].f[q] = screen[q][r];
+    for (int r = 0; r < 3; r++)
+        for (int q = 0; q < 4; q++)
+            k[SKIN_C_EYE + r].f[q] = (*mv)[q][r];
+    for (int b = 0; b < nbones; b++)
+        for (int r = 0; r < 3; r++)
+            for (int q = 0; q < 4; q++)
+                k[SKIN_C_BONES + 3 * b + r].f[q] = palette[b][4 * r + q];
+    int lit = ls->lighting_enabled != 0;
+    k[SKIN_C_AMBIENT].f[0] = lit ? ls->light_model_ambient[0] : 0.0f;
+    k[SKIN_C_AMBIENT].f[1] = lit ? ls->light_model_ambient[1] : 0.0f;
+    k[SKIN_C_AMBIENT].f[2] = lit ? ls->light_model_ambient[2] : 0.0f;
+    k[SKIN_C_AMBIENT].f[3] = lit ? 1.0f : 0.0f;
+    int nl = 0;
+    for (int i = 0; i < GLI_MAX_LIGHTS && nl < 3; i++) {
+        const light_t *l = &ls->lights[i];
+        if (!lit || !l->enabled || l->position[3] != 0.0f)
+            continue;               /* (the lights of the game are directional) */
+        float x = l->position[0], y = l->position[1], z = l->position[2], len = sqrtf(x * x + y * y + z * z);
+        if (len <= 0.0f)
+            continue;
+        k[SKIN_C_LDIR + nl].f[0] = x / len;
+        k[SKIN_C_LDIR + nl].f[1] = y / len;
+        k[SKIN_C_LDIR + nl].f[2] = z / len;
+        k[SKIN_C_LDIR + nl].f[3] = 0.0f;
+        k[SKIN_C_LCOL + nl].f[0] = l->diffuse[0];
+        k[SKIN_C_LCOL + nl].f[1] = l->diffuse[1];
+        k[SKIN_C_LCOL + nl].f[2] = l->diffuse[2];
+        k[SKIN_C_LCOL + nl].f[3] = 0.0f;
+        nl++;
+    }
+    for (; nl < 3; nl++) {
+        k[SKIN_C_LDIR + nl].f[0] = k[SKIN_C_LDIR + nl].f[1] = k[SKIN_C_LDIR + nl].f[3] = 0.0f;
+        k[SKIN_C_LDIR + nl].f[2] = 1.0f;
+        k[SKIN_C_LCOL + nl].f[0] = k[SKIN_C_LCOL + nl].f[1] = k[SKIN_C_LCOL + nl].f[2] = k[SKIN_C_LCOL + nl].f[3] = 0.0f;
+    }
+    float us = 1.0f, vs = 1.0f;     /* (the fixed-function texture matrix scales to what the texture wants) */
+    texture_unit_t *tu = &c->texture_environment.texture_units[0];
+    if (tu->bound_texture_object && tu->bound_texture_object->texture_2d) {
+        const xgu_texture_t *xt = (const xgu_texture_t *)tu->bound_texture_object->texture_2d;
+        us = xt->u_scale;
+        vs = xt->v_scale;
+    }
+    k[SKIN_C_TSCALE].f[0] = us;
+    k[SKIN_C_TSCALE].f[1] = vs;
+    k[SKIN_C_TSCALE].f[2] = 0.0f;
+    k[SKIN_C_TSCALE].f[3] = 0.0f;
+    k[SKIN_C_LITERAL].f[0] = 0.0f;
+    k[SKIN_C_LITERAL].f[1] = 1.0f;
+    k[SKIN_C_LITERAL].f[2] = 3.0f;
+    k[SKIN_C_LITERAL].f[3] = 0.0f;
+
+    uint32_t *pb;
+    if (!skin_program_loaded) {
+        const unsigned int n = sizeof skin_program / sizeof skin_program[0];
+        pb = pb_begin();
+        pb = xgu_set_transform_program_load(pb, 0);
+        pb_end(pb);
+        for (unsigned int i = 0; i < n; i += 8) {
+            pb = pb_begin();
+            pb = xgu_set_transform_program(pb, &skin_program[i], n - i < 8 ? n - i : 8);
+            pb_end(pb);
+        }
+        skin_program_loaded = GL_TRUE;
+    }
+    pb = pb_begin();
+    pb = skin_constants(pb, SKIN_C_SCREEN, &k[SKIN_C_SCREEN], 4);
+    pb = skin_constants(pb, SKIN_C_BONES, &k[SKIN_C_BONES], 3u * (unsigned int)nbones);
+    pb_end(pb);
+    pb = pb_begin();
+    pb = skin_constants(pb, SKIN_C_EYE, &k[SKIN_C_EYE], SKIN_C_COUNT - SKIN_C_EYE);
+    pb = xgu_set_transform_program_start(pb, 0);
+    pb = xgu_set_transform_execution_mode(pb, XGU_PROGRAM, XGU_RANGE_MODE_PRIVATE);
+    pb = xgu_set_transform_program_cxt_write_enable(pb, false);
+    pb = direct_common_arrays(pb, c, pos, nrm, uv, col);
+    pb = direct_attrib(pb, XGU_TEXCOORD1_ARRAY, 4, 4 * sizeof(float), bone);
+    pb = direct_attrib(pb, XGU_TEXCOORD2_ARRAY, 4, 4 * sizeof(float), weight);
+    pb = pb_push1(pb, NV097_BREAK_VERTEX_BUFFER_CACHE, 0);
+    pb_end(pb);
+    xgux_draw_elements16(XGU_TRIANGLES, idx, (unsigned int)count);
+    pb = pb_begin();                /* the fixed-function pipeline again, the two extra arrays off */
+    pb = xgu_set_transform_execution_mode(pb, XGU_FIXED, XGU_RANGE_MODE_PRIVATE);
+    pb = direct_attrib_off(pb, XGU_TEXCOORD1_ARRAY);
+    pb = direct_attrib_off(pb, XGU_TEXCOORD2_ARRAY);
+    pb_end(pb);
+    direct_arrays_dirty(&c->vertex_array_data);
+}
