diff --git a/lib/pbkit/pbkit.c b/lib/pbkit/pbkit.c
index ba7c99e..95120f3 100644
--- a/lib/pbkit/pbkit.c
+++ b/lib/pbkit/pbkit.c
@@ -133,6 +133,10 @@ static  DWORD           pb_FifoBigInst;     //graphic contexts are stored there,
 
 static  DWORD           pb_FreeInst;        //next free space in PRAMIN area (addr=inst<<4+NV_PRAMIN)
 
+static  volatile DWORD pb_FramesDone=0;    //frames whose end the GPU has reached (pb_frames_done)
+static  int         pb_DepthOnBootScreen=0; //pb_depth_on_boot_screen
+static  int         pb_DepthBorrowed=0;     //the depth buffer is nxdk's boot screen: not ours to free
+static  int         pb_WantedBackBuffers=2; //pb_back_buffers: 2 = triple buffering (default), 1 = front + one back
 static  int         pb_BackBufferNxt=0;
 static  int         pb_BackBufferNxtVBL=0;
 static  int         pb_BackBufferbReady[3]={0,0,0};
@@ -333,6 +337,7 @@ static void pb_subprog(DWORD subprogID, DWORD paramA, DWORD paramB)
             next=pb_BackBufferNxt;
             pb_BackBufferIndex[next]=paramA;
             pb_BackBufferbReady[next]=1;
+            pb_FramesDone++;
             next=(next+1)%3;
             pb_BackBufferNxt=next;
             break;
@@ -1623,6 +1628,40 @@ DWORD pb_back_buffer_pitch(void)
     return pb_FrameBuffersPitch;
 }
 
+//Front + n back buffers (n = 1 or 2, default 2). With one back buffer the GPU itself waits for the
+//vertical blank that shows a finished frame before it draws into the buffer that was on screen
+//(NV097_FLIP_STALL, released by the blank handler's READ_3D increment), as Direct3D does.
+//Call it before pb_init.
+void pb_back_buffers(int n)
+{
+    if (!pb_running&&(n==1||n==2))
+        pb_WantedBackBuffers=n;
+}
+
+//How many frames the GPU has drawn to their end (every pb_finished that returned 0 adds one when the GPU
+//reaches it): what an application sending frames ahead of the GPU compares its own count with.
+DWORD pb_frames_done(void)
+{
+    return pb_FramesDone;
+}
+
+//XVideoSetMode leaves a whole screen of its own allocated (the one debugPrint draws on), which is never
+//shown again once pb_init has made its buffers. With this set, pb_init uses that memory as the depth
+//buffer instead of allocating another screen's worth (1.2 MB at 640x480x32, 3.5 MB at 1280x720x32) when
+//its size and alignment fit; it stays nxdk's allocation and pb_kill leaves it alone. debugPrint text then
+//lands in the depth buffer, which every frame clears. Call it before pb_init.
+void pb_depth_on_boot_screen(int on)
+{
+    if (!pb_running) pb_DepthOnBootScreen=on;
+}
+
+//frame buffer #i (0 .. back buffers), NULL outside
+DWORD *pb_frame_buffer(int i)
+{
+    if (i<0||(DWORD)i>=pb_FrameBuffersCount) return NULL;
+    return (DWORD *)pb_FBAddr[i];
+}
+
 DWORD *pb_back_buffer(void)
 {
     return (DWORD *)pb_FBAddr[pb_back_index];
@@ -2062,12 +2101,17 @@ int pb_finished(void)
     p=pb_push1(p,NV20_TCL_PRIMITIVE_3D_WAIT_MAKESPACE,0); //wait/makespace (obtains null status)
     p=pb_push1(p,NV20_TCL_PRIMITIVE_3D_PARAMETER_A,pb_back_index); //set param=back buffer index to show up
     p=pb_push1(p,NV20_TCL_PRIMITIVE_3D_FIRE_INTERRUPT,PB_FINISHED); //subprogID PB_FINISHED: gets frame ready to show up soon
-//  p=pb_push1(p,NV20_TCL_PRIMITIVE_3D_STALL_PIPELINE,0); //stall gpu pipeline (not sure it's needed in triple buffering technic)
+    if (pb_FrameBuffersCount==2)
+    {
+        //two buffers: the next one to draw into is the one on screen until this frame shows up
+        p=pb_push1(p,NV097_FLIP_INCREMENT_WRITE,0);
+        p=pb_push1(p,NV097_FLIP_STALL,0); //the GPU waits here for the blank that shows this frame
+    }
     pb_end(p);
 
     //insert in push buffer the commands to trigger selection of next back buffer
     //(because previous ones may not have finished yet, so need to use 0x0100 call)
-    pb_back_index=(pb_back_index+1)%3;
+    pb_back_index=(pb_back_index+1)%(int)pb_FrameBuffersCount;
     pb_target_back_buffer();
     pb_start(); //the frame's last blocks must not wait for a later one
 
@@ -2136,7 +2180,7 @@ void pb_kill(void)
     KeRemoveQueueDpc(&pb_DPCObject);
 
     if (pb_ExtraBuffersCount) MmFreeContiguousMemory((PVOID)pb_EXAddr[0]);
-    if (pb_DepthStencilAddr) MmFreeContiguousMemory((PVOID)pb_DepthStencilAddr);
+    if (pb_DepthStencilAddr && !pb_DepthBorrowed) MmFreeContiguousMemory((PVOID)pb_DepthStencilAddr);
     if (pb_FrameBuffersAddr) MmFreeContiguousMemory((PVOID)pb_FrameBuffersAddr);
 
     if (pb_DmaBuffer8) MmFreeContiguousMemory(pb_DmaBuffer8);
@@ -2974,7 +3018,7 @@ int pb_init(void)
     Width=vm.width;
     Height=vm.height;
 
-    BackBufferCount=2;          //triple buffering technic!
+    BackBufferCount=pb_WantedBackBuffers;   //2: triple buffering technic!
                         //allows dynamic details adjustment
 
     pb_FrameBuffersCount=BackBufferCount+1; //front buffer + back buffers
@@ -3092,6 +3136,18 @@ int pb_init(void)
     //Huge alignment enforcement (16 Kb aligned!) for the global size
     DSSize=(DSSize+0x3FFF)&0xFFFFC000;
 
+    DSAddr=0;
+    pb_DepthBorrowed=0;
+    if (pb_DepthOnBootScreen)
+    {
+        DWORD boot=(DWORD)XVideoGetFB();
+        if (boot && (boot&0x3FFF)==0 && (boot&0x0FFFFFFF)+DSSize<=0x03FFB000 && MmQueryAllocationSize((PVOID)boot)>=DSSize)
+        {
+            DSAddr=boot;
+            pb_DepthBorrowed=1;
+        }
+    }
+    if (!DSAddr)
     DSAddr = (DWORD)MmAllocateContiguousMemoryEx(DSSize, 0, 0x03FFB000, 0x4000, PAGE_READWRITE | PAGE_WRITECOMBINE);
 
     pb_DepthStencilAddr=DSAddr;
@@ -3321,6 +3377,16 @@ int pb_init(void)
     memset((DWORD *)pb_FBAddr[0],0,pb_FBSize);
     memset((DWORD *)pb_DSAddr,0,pb_DSSize);
 
+    if (pb_FrameBuffersCount==2)
+    {
+        //the flip counters NV097_FLIP_STALL compares: buffer 0 is shown, buffer 1 is drawn into
+        p=pb_begin();
+        p=pb_push1(p,NV097_SET_FLIP_READ,0);
+        p=pb_push1(p,NV097_SET_FLIP_WRITE,1);
+        p=pb_push1(p,NV097_SET_FLIP_MODULO,2);
+        pb_end(p);
+    }
+
     pb_back_index=1;        //frame buffer #1 is the back buffer for now
     pb_target_back_buffer();    //tells GPU what is the frame buffer target
 
diff --git a/lib/pbkit/pbkit.h b/lib/pbkit/pbkit.h
index 6c1b819..6b36fd8 100644
--- a/lib/pbkit/pbkit.h
+++ b/lib/pbkit/pbkit.h
@@ -66,6 +66,10 @@ void    pb_target_back_buffer(void);    //to have rendering made into normal rot
 
 DWORD   *pb_extra_buffer(int n);    //returns a static extra buffer address
 DWORD   *pb_back_buffer(void);      //returns normal rotating back buffer address
+DWORD   pb_frames_done(void);       //frames the GPU has drawn to their end
+void    pb_back_buffers(int n);     //front + n back buffers, n = 1 or 2 (default 2) (call it before pb_init)
+DWORD   *pb_frame_buffer(int i);    //frame buffer #i, 0 .. back buffers
+void    pb_depth_on_boot_screen(int on);    //depth buffer in the screen XVideoSetMode left allocated (call it before pb_init)
 DWORD   pb_back_buffer_width(void);
 DWORD   pb_back_buffer_height(void);
 DWORD   pb_back_buffer_pitch(void);
