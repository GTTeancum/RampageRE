+/* Called at each frame's end with how many frames have been ended and how many of them the GPU has drawn to their
+ * end. A copy released while frame F was being sent can only be read by frames up to F, so it is freed as soon as
+ * the GPU has finished F, without waiting for the GPU to be idle: with a push buffer several frames long the
+ * restart that used to free them comes only every few frames, and a frame's worth of remade copies and quad
+ * chunks piled up meanwhile. */
+void gliStaticArraysFrames(uint32_t sent, uint32_t done)
+{
+    st_frame_now = sent;
+    int n = 0;
+    while (n < st_npending && (int32_t)(done - st_pending_frame[n]) > 0) st_free(st_pending[n++]);
+    if (n) {
+        st_npending -= n;
+        for (int i = 0; i < st_npending; i++) {
+            st_pending[i] = st_pending[i + n];
+            st_pending_frame[i] = st_pending_frame[i + n];
+        }
+    }
+}
+
 static void st_release(uint8_t *dst)
 {
