+/* Prototype measurement only, not a public GL extension. */
+size_t gliTextureBoundResidentBytes(void)
+{
+    gli_context_t *context = gliGetContext();
+    GLuint unit = context->texture_environment.server_active_texture - GL_TEXTURE0;
+    texture_object_t *object = context->texture_environment.texture_units[unit].bound_texture_object;
+    xgu_texture_t *texture = object ? (xgu_texture_t *)object->texture_2d : NULL;
+    return texture && texture->data ? MmQueryAllocationSize(texture->data) : 0;
+}
