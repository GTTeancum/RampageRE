+    if (!gli_palette_build(&map, (const uint32_t *)texture->data, count)) return GL_FALSE;
+    GLubyte *data = MmAllocateContiguousMemoryEx(size, 0, 0x03FFAFFF, 0x1000, PAGE_READWRITE | PAGE_WRITECOMBINE);
+    if (!data) return GL_FALSE; /* Optimization failure preserves the original texture. */
+    gli_palette_indices(&map, (const uint32_t *)texture->data, count, data);
+    uint32_t *palette = (uint32_t *)(data + palette_offset);
+    for (unsigned i = 0; i < 256; ++i) palette[i] = i < map.count ? map.colors[i] : 0;
+    __asm__ volatile("sfence" ::: "memory");
+    MmFreeContiguousMemory(texture->data);
+    texture->data = data;
+    texture->data_physical_address = (GLubyte *)MmGetPhysicalAddress(data);
+    texture->data_size = size;
+    texture->bytes_per_pixel = 1;
+    texture->pitch = texture->data_width;
+    texture->palette_offset = palette_offset;
+    texture->format = (XguTexFormatColor)NV097_SET_TEXTURE_FORMAT_COLOR_SZ_I8_A8R8G8B8;
+    object->texture_object_dirty = GL_TRUE;
+    return GL_TRUE;
+}
