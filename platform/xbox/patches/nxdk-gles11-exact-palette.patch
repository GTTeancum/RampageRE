+/* Exact BGRA dictionary; no color quantization or transparent-pixel omission. */
+#ifndef GLI_PALETTE_CODEC_H
+#define GLI_PALETTE_CODEC_H
+#include <stddef.h>
+#include <stdint.h>
+typedef struct { uint32_t keys[512], colors[256]; uint16_t slots[512], count; } gli_palette_map_t;
+static unsigned gli_palette_hash(uint32_t color) { return (color * 2654435761u) >> 23; }
+static int gli_palette_build(gli_palette_map_t *map, const uint32_t *pixels, size_t count)
+{
+    for (unsigned i = 0; i < 512; ++i) map->slots[i] = 0;
+    map->count = 0;
+    if (!count) return 0;
+    for (size_t i = 0; i < count; ++i) {
+        uint32_t color = pixels[i]; unsigned at = gli_palette_hash(color);
+        while (map->slots[at] && map->keys[at] != color) at = (at + 1) & 511;
+        if (!map->slots[at]) {
+            if (map->count == 256) return 0;
+            map->keys[at] = color; map->colors[map->count] = color;
+            map->slots[at] = ++map->count;
+        }
+    }
+    return 1;
+}
+static void gli_palette_indices(const gli_palette_map_t *map, const uint32_t *pixels, size_t count, uint8_t *indices)
+{
+    for (size_t i = 0; i < count; ++i) {
+        uint32_t color = pixels[i]; unsigned at = gli_palette_hash(color);
+        while (map->keys[at] != color || !map->slots[at]) at = (at + 1) & 511;
+        indices[i] = (uint8_t)(map->slots[at] - 1);
+    }
+}
+#endif
