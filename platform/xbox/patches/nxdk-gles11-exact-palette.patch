+/* Experimental opt-in storage conversion. Caller flushes its frontend before
+ * invoking this native driver function; ordinary GL uploads do not opt in. */
+GLboolean gliTextureTryPalette(void)
+{
+    gli_context_t *context = gliGetContext();
+    GLuint unit = context->texture_environment.server_active_texture - GL_TEXTURE0;
+    texture_object_t *object = context->texture_environment.texture_units[unit].bound_texture_object;
+    xgu_texture_t *texture = object ? (xgu_texture_t *)object->texture_2d : NULL;
+    if (!texture || !texture->data || texture->palette_offset || !texture->swizzled ||
+        texture->mipmap_levels != 1 || object->generate_mipmap ||
+        texture->format != XGU_TEXTURE_FORMAT_A8R8G8B8_SWIZZLED || texture->bytes_per_pixel != 4 ||
+        texture->tex_width < 8 || texture->tex_height < 8 ||
+        texture->tex_width != texture->data_width || texture->tex_height != texture->data_height ||
+        texture->data_width > 4096 || texture->data_height > 4096) return GL_FALSE;
+    size_t count = (size_t)texture->data_width * texture->data_height;
+    if (count > texture->data_size / 4u) return GL_FALSE;
+    size_t palette_offset = (count + 63u) & ~(size_t)63u;
+    size_t size = palette_offset + 1024;
+    if (((size + 4095u) & ~(size_t)4095u) >= MmQueryAllocationSize(texture->data)) return GL_FALSE;
+    glFinish();
