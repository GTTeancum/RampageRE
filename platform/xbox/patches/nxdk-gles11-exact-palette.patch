+/* Preserve ordinary GL semantics if a paletted image later becomes mutable,
+ * gains mipmaps, or is attached as a render target. Failure leaves it intact. */
+GLboolean gliTextureUnpackPalette(texture_object_t *object)
+{
+    xgu_texture_t *texture = object ? (xgu_texture_t *)object->texture_2d : NULL;
+    if (!texture || !texture->palette_offset) return GL_TRUE;
+    size_t count = (size_t)texture->data_width * texture->data_height;
+    GLubyte *data = MmAllocateContiguousMemoryEx(count * 4, 0, 0x03FFAFFF, 0x1000, PAGE_READWRITE | PAGE_WRITECOMBINE);
+    if (!data) { gliSetError(GL_OUT_OF_MEMORY); return GL_FALSE; }
+    glFinish();
+    const uint32_t *palette = (const uint32_t *)(texture->data + texture->palette_offset);
+    for (size_t i = 0; i < count; ++i) ((uint32_t *)data)[i] = palette[texture->data[i]];
+    __asm__ volatile("sfence" ::: "memory");
+    MmFreeContiguousMemory(texture->data);
+    texture->data = data;
+    texture->data_physical_address = (GLubyte *)MmGetPhysicalAddress(data);
+    texture->data_size = count * 4;
+    texture->bytes_per_pixel = 4;
+    texture->pitch = texture->data_width * 4;
+    texture->palette_offset = 0;
+    texture->format = XGU_TEXTURE_FORMAT_A8R8G8B8_SWIZZLED;
+    object->texture_object_dirty = GL_TRUE;
+    return GL_TRUE;
+}
