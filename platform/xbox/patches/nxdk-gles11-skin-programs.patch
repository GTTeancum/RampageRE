+/* Triangles by 16-bit indices sent inline (the NV2A has no index buffers). xgux_draw_elements16 ends and begins a
+ * push-buffer block every 240 indices; a batch of the city is 30,000. Here a method carries up to 2,000, and the
+ * indices are copied once, straight into the push buffer. */
+#define DIRECT_ELEMENT_WORDS 1000u  /* (a method takes up to 2,047 parameters; two indices each) */
+static void direct_elements16(const uint16_t *idx, unsigned int count)
+{
+    uint32_t *p = pb_begin();
+    p = xgu_begin(p, XGU_TRIANGLES);
+    unsigned int words = count / 2u, at = 0;
+    while (at < words) {
+        unsigned int n = words - at < DIRECT_ELEMENT_WORDS ? words - at : DIRECT_ELEMENT_WORDS;
+        p = xgu_element16(p, &idx[2u * at], 2u * n);
+        at += n;
+        if (at < words) {           /* (a block is bounded so the room check between blocks can act) */
+            pb_end(p);
+            p = pb_begin();
+        }
+    }
+    if (count & 1u) {
+        uint32_t last = idx[count - 1u];
+        p = xgu_element32(p, &last, 1);
+    }
+    p = xgu_end(p);
+    pb_end(p);
+}
