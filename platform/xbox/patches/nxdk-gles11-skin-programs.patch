+/* Quads from one interleaved array in GPU memory, 24 bytes a vertex as the Xbox prototype's effects and HUD
+ * (docs/xbox_proto/EFFECTS_HUD.md): position (3 floats), colour (4 bytes: red, green, blue, alpha), texture
+ * coordinates (2 floats). No indices: four vertices a quad, in order. The GL state is what it is; the current
+ * normal stands in for the missing normals. */
+void gliDirectQuads(const void *verts, GLsizei nverts)
+{
+    gli_context_t *c = gliGetContext();
+    vertex_array_data_t *vad = &c->vertex_array_data;
+    current_values_t *cv = &c->current_values;
+    nverts &= ~3;
+    if (nverts <= 0 || !verts)
+        return;
+    gliPushbufferReserve(4096u + (size_t)nverts / 32u);
+    direct_flush_state();
+    const uint8_t *base = (const uint8_t *)((uintptr_t)verts & 0x03FFFFFFu);
+    uint32_t *pb = pb_begin();
+    pb = xgu_set_vertex_data_array_format(pb, XGU_VERTEX_ARRAY, XGU_FLOAT, 3, 24);
+    pb = xgu_set_vertex_data_array_offset(pb, XGU_VERTEX_ARRAY, base);
+    pb = xgu_set_vertex_data_array_format(pb, XGU_COLOR_ARRAY, XGU_UNSIGNED_BYTE_OGL, 4, 24);
+    pb = xgu_set_vertex_data_array_offset(pb, XGU_COLOR_ARRAY, base + 12);
+    pb = xgu_set_vertex_data_array_format(pb, XGU_TEXCOORD0_ARRAY, XGU_FLOAT, 2, 24);
+    pb = xgu_set_vertex_data_array_offset(pb, XGU_TEXCOORD0_ARRAY, base + 16);
+    pb = direct_attrib_off(pb, XGU_NORMAL_ARRAY);
+    pb = xgu_set_vertex_data4f(pb, XGU_NORMAL_ARRAY, cv->current_normal[0], cv->current_normal[1],
+                               cv->current_normal[2], 0.0f);
+    for (GLuint i = 1; i < GLI_MAX_TEXTURE_UNITS && i < 4; i++)
+        if (vad->texcoord_array_enabled[i])
+            pb = direct_attrib_off(pb, XGU_TEXCOORD0_ARRAY + i);
+    if (vad->point_size_array_enabled)
+        pb = direct_attrib_off(pb, XGU_POINT_SIZE_ARRAY);
+    if (vad->fog_coord_array_enabled)
+        pb = direct_attrib_off(pb, XGU_FOG_ARRAY);
+    pb = pb_push1(pb, NV097_BREAK_VERTEX_BUFFER_CACHE, 0);
+    pb = xgu_begin(pb, XGU_QUADS);
+    for (unsigned int at = 0, left = (unsigned int)nverts; left;) {
+        unsigned int n = left < 256u ? left : 256u;     /* (a multiple of four: whole quads a method) */
+        pb = xgu_draw_arrays(pb, at, n);
+        at += n;
+        left -= n;
+    }
+    pb = xgu_end(pb);
+    pb_end(pb);
+    direct_arrays_dirty(vad);
+}
