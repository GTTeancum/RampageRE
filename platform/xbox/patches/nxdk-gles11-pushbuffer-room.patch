 /* Private pbkit helper; no presentation tracing. */
 extern void pb_reset_drain_guard(unsigned phase);
 
+/* pbkit restarts its push buffer only at pb_reset and never checks for room:
+ * a frame past PBKIT_PUSHBUFFER_SIZE (plus pbkit's 8 KiB slack) writes into
+ * whatever follows the buffer and the GPU fetches that as methods ("DMA push
+ * buffer engine encountered invalid data", seen on a real Xbox past
+ * head + 0x82000). Before each draw, a frame close to the end drains the GPU
+ * and restarts at the head, as glFlipNV2A does every frame. */
+#define GLI_PUSHBUFFER_SIZE (512u * 1024u) /* PBKIT_PUSHBUFFER_SIZE; pb_size is never called */
+#define GLI_PUSHBUFFER_MARGIN (64u * 1024u) /* state and setup methods between two checks */
+static uint8_t *gli_pushbuffer_start; /* pbkit's head once the first reset has run */
+
+static void gli_pushbuffer_restart(void)
+{
+    pb_reset_drain_guard(1);
+    pb_reset();
+    pb_reset_drain_guard(2);
+    uint32_t *head = pb_begin();
+    pb_end(head);
+    gli_pushbuffer_start = (uint8_t *)head;
+}
+
+void gliPushbufferReserve(size_t bytes)
+{
+    uint32_t *put = pb_begin();
+    pb_end(put);
+    if (!gli_pushbuffer_start)  /* before the first frame's reset: pb_init's few methods are not counted */
+        gli_pushbuffer_start = (uint8_t *)put;
+    size_t used = (size_t)((uint8_t *)put - gli_pushbuffer_start);
+    if (bytes > GLI_PUSHBUFFER_SIZE - GLI_PUSHBUFFER_MARGIN)
+        bytes = GLI_PUSHBUFFER_SIZE - GLI_PUSHBUFFER_MARGIN; /* one draw this large overflows anyway */
+    if (used > GLI_PUSHBUFFER_SIZE - GLI_PUSHBUFFER_MARGIN - bytes)
+        gli_pushbuffer_restart();
+}
+
 static int gl_swap_interval = 1;
 static GLboolean gl_show_fps = GL_FALSE;
 
