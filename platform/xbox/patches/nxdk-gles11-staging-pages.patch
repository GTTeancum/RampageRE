+/* Conservative upper bound including alignment for every active client array.
+ * Shared/interleaved ranges may use less space, but reserving them separately
+ * guarantees that no current-draw attribute can be invalidated by ring wrap. */
+static GLboolean reserve_client_array(size_t *required, GLboolean enabled,
+                                      GLuint binding, const void *ptr,
+                                      GLint components, GLenum type,
+                                      GLsizei stride, GLsizei count)
+{
+    if (!enabled || binding != 0 || !ptr)
+        return GL_TRUE;
+    size_t element = (size_t)components * gliEnumtoByteSize(type);
+    size_t step = stride ? (size_t)stride : element;
+    size_t bytes;
+    if (step > element) {
+        if ((size_t)count > GLI_STAGING_ARENA_SIZE / step)
+            return GL_FALSE;
+        bytes = (size_t)count * step;
+    } else {
+        if (element > GLI_STAGING_ARENA_SIZE ||
+            (step && (size_t)(count - 1) > (GLI_STAGING_ARENA_SIZE - element) / step))
+            return GL_FALSE;
+        bytes = (size_t)(count - 1) * step + element;
+    }
+    /* arena is compiled with ARENA_ALIGNMENT_SIZE=31 by CMakeLists.txt. */
+    bytes = (bytes + 31u) & ~(size_t)31u;
+    if (bytes > GLI_STAGING_ARENA_SIZE - *required)
+        return GL_FALSE;
+    *required += bytes;
+    return GL_TRUE;
+}
+
+static GLboolean reserve_client_draw(vertex_array_data_t *v, arena_t *arena, GLsizei count)
+{
+    size_t required = 0;
+#define RESERVE(enabled, binding, ptr, size, type, stride) \
+    if (!reserve_client_array(&required, (enabled), (binding), (ptr), (size), (type), (stride), count)) \
+        goto too_large
+    RESERVE(v->vertex_array_enabled, v->vertex_array_buffer_binding, v->vertex_array_ptr,
+            v->vertex_array_size, v->vertex_array_type, v->vertex_array_stride);
+    RESERVE(v->normal_array_enabled, v->normal_array_buffer_binding, v->normal_array_ptr,
+            3, v->normal_array_type, v->normal_array_stride);
+    RESERVE(v->color_array_enabled, v->color_array_buffer_binding, v->color_array_ptr,
+            v->color_array_size, v->color_array_type, v->color_array_stride);
+    for (GLuint i = 0; i < GLI_MAX_TEXTURE_UNITS; ++i) {
+        RESERVE(v->texcoord_array_enabled[i], v->texcoord_array_buffer_binding[i], v->texcoord_array_ptr[i],
+                v->texcoord_array_size[i], v->texcoord_array_type[i], v->texcoord_array_stride[i]);
+    }
+    RESERVE(v->point_size_array_enabled, v->point_size_array_buffer_binding, v->point_size_array_ptr,
+            1, v->point_size_array_type, v->point_size_array_stride);
+    RESERVE(v->fog_coord_array_enabled, v->fog_coord_array_buffer_binding, v->fog_coord_array_ptr,
+            1, v->fog_coord_array_type, v->fog_coord_array_stride);
+#undef RESERVE
+    if (arena_available(arena) < required) {
+        /* Previous packets may still DMA from this memory. Wait for a GPU-written
+         * completion value before reuse, outside any current draw packet. */
+        *staging_fence = 0;
+        uint32_t *pb = pb_begin();
+        /* pbkit DMA context 3 spans 0..GLI_STAGING_DMA_MAX, also used by vertex DMA. */
+        pb = pb_push1(pb, NV097_SET_CONTEXT_DMA_SEMAPHORE, 3);
+        pb = pb_push1(pb, NV097_SET_SEMAPHORE_OFFSET, MmGetPhysicalAddress((PVOID)staging_fence));
+        pb = pb_push1(pb, NV097_BACK_END_WRITE_SEMAPHORE_RELEASE, 1);
+        pb_end(pb);
+        while (*staging_fence != 1) NtYieldExecution();
+        arena_reset(arena);
+    }
+    return GL_TRUE;
+too_large:
+    gliSetError(GL_OUT_OF_MEMORY);
+    gliDebugF("[gles] Client draw exceeds staging arena (%u bytes)\n", (unsigned)GLI_STAGING_ARENA_SIZE);
+    return GL_FALSE;
+}
