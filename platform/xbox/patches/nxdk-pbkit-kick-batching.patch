diff --git a/lib/pbkit/pbkit.c b/lib/pbkit/pbkit.c
index b6c971a..bd6e31e 100644
--- a/lib/pbkit/pbkit.c
+++ b/lib/pbkit/pbkit.c
@@ -97,6 +97,13 @@ static  DWORD           pb_Size=PBKIT_PUSHBUFFER_SIZE;//push buffer size, must b
 static  uint32_t        *pb_Head;   //points at push buffer head
 static  uint32_t        *pb_Tail;   //points at push buffer tail
 static  uint32_t        *pb_Put=NULL;   //where next command+params are to be written
+/* Each PUT update costs a write-combine flush and two register round trips; a frame makes
+ * thousands of small blocks. Once initialised, pb_end only hands the GPU new work every
+ * PB_KICK_BYTES; everything that waits on the GPU (pb_busy, pb_finished, pb_wait_for_vbl,
+ * pb_reset, pb_kill) submits what is outstanding first. */
+#define PB_KICK_BYTES 4096u
+static  uint32_t        *pb_Kicked=NULL; //pb_Put as last given to the GPU
+static  int             pb_kick_batching=0;
 
 static  float           pb_CpuFrequency;
 
@@ -1490,6 +1497,7 @@ static void pb_start(void)
 
         pb_cache_flush();
         *(pb_DmaUserAddr+0x40/4)=((DWORD)pb_Put)&0x03FFFFFF;
+        pb_Kicked=pb_Put;
         //from now any write will be detected
 
 #ifdef DBG
@@ -1573,6 +1581,8 @@ int pb_busy(void)
     DWORD           PutAddr;
     DWORD           GetAddr;
 
+    if (pb_Put!=pb_Kicked) pb_start(); //submit batched blocks before judging progress
+
     GetAddr=*(pb_DmaUserAddr+0x44/4);
 #ifdef DBG
     if (GetAddr>0x04000000)
@@ -1759,6 +1769,7 @@ DWORD pb_get_vbl_counter(void)
 
 DWORD pb_wait_for_vbl(void)
 {
+    if (pb_Put && pb_Put!=pb_Kicked) pb_start();
     NtWaitForSingleObject(pb_VBlankEvent, FALSE, NULL);
     return pb_vbl_counter; //allows caller to know if a frame has been missed
 }
@@ -1876,7 +1887,9 @@ void pb_end(uint32_t *pEnd)
 
     pb_Put=pEnd;
 
-    pb_start(); //start (or continue) reading and sending data to GPU
+    if (!pb_kick_batching || pb_trace_mode || pb_Put<pb_Kicked ||
+        (DWORD)pb_Put-(DWORD)pb_Kicked>=PB_KICK_BYTES)
+        pb_start(); //start (or continue) reading and sending data to GPU
 
     if (pb_trace_mode) //do we want to wait until block data has been sent (for debugging GPU errors)?
     {
@@ -2041,6 +2054,7 @@ int pb_finished(void)
     //(because previous ones may not have finished yet, so need to use 0x0100 call)
     pb_back_index=(pb_back_index+1)%3;
     pb_target_back_buffer();
+    pb_start(); //the frame's last blocks must not wait for a later one
 
     return 0;
 }
@@ -2060,6 +2074,7 @@ void pb_kill(void)
     int         counter;
 
     rg_lifecycle_kill_begin();
+    pb_kick_batching=0;
     HalRegisterShutdownNotification(&pb_shutdown_registration, FALSE);
 
 #ifdef DBG
@@ -3284,6 +3299,8 @@ int pb_init(void)
     HalRegisterShutdownNotification(&pb_shutdown_registration, TRUE);
 
     if (!rg_lifecycle_init_complete()) return -8;
+    pb_start();
+    pb_kick_batching=1;
     return 0;
 }
 
